{
  "extends": "@react-native/typescript-config",
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {},
    "types": ["jest", "react"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "inlineSources": true,
    "sourceMap": true,
    "target": "es2017",
    "checkJs": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "declaration": false,
    "diagnostics": true,
    "noImplicitAny": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowJs": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true
  },
  "include": ["./src/**/*.tsx", "./src/**/*.ts", "./src/*.tsx"],
  "exclude": [
    "node_modules",
    "lib",
    "./src/tests",
    "./src/**/__test__",
    "./src/**/*.test.*",
    "./src/**/*.spec.*",
    "**/Pods"
  ]
}
